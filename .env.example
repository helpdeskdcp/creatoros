# =============================================================================
# CreatorOS environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=CreatorOS
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# --- Database -----------------------------------------------------------------
# Async SQLAlchemy URL used by the API/workers
DATABASE_URL=postgresql+asyncpg://creatoros:creatoros@localhost:5432/creatoros
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://creatoros:creatoros@localhost:5432/creatoros

# --- Redis / Celery -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth / Security ------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-random-64-byte-secret
JWT_ALGORITHM=HS256
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# --- YouTube Data / Analytics API (Google) -------------------------------
# https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/channels/oauth/callback
YOUTUBE_API_KEY=

# --- AI Providers -----------------------------------------------------------
# Default provider used by the AI orchestrator: "ollama" or "openai"
AI_PRIMARY_PROVIDER=ollama
AI_FALLBACK_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Notifications ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@creatoros.local
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
